##
## Jira Integration — bin/jira
## Copy to .env.jira and fill in your values.
## Keep this file in .gitignore — never commit your API token.
##
## Get your API token at: https://id.atlassian.com/manage-profile/security/api-tokens
##

JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

## Agent directory name at project root (default: .jira)
## Works like .junie or .claude — one subdirectory per ticket.
##
##   .jira/
##   └── JIRA-123/
##       ├── JIRA-123.md
##       └── attachments/
##
JIRA_DIR=.jira

## Dynamic custom fields
##
## JSON format (recommended for readability):
## JIRA_CUSTOM_FIELDS='[
##   {"label": "Acceptance Criteria",    "id": "customfield_11756"},
##   {"label": "Technical Notes",        "id": "customfield_11944"},
##   {"label": "Release Notes",          "id": "customfield_11965"},
##   {"label": "Post Go-Live Notes",     "id": "customfield_11814"}
## ]'
##
## Each entry becomes its own ## section in the exported Markdown, rendered
## in the order listed here. Add as many as your project uses.
##
## If this variable is not set, no custom field sections are exported —
## only the Description will be included in the output.
##
## To find the correct fieldId for your Jira instance, run:
##   bin/jira --list-fields (or -l)
##
JIRA_CUSTOM_FIELDS='[
  {"label": "Acceptance Criteria",    "id": "customfield_11756"},
  {"label": "Technical Notes",        "id": "customfield_11944"},
  {"label": "Release Notes",          "id": "customfield_11965"},
  {"label": "Post Go-Live Notes",     "id": "customfield_11814"}
]'

## Security & redaction
##
## JIRA_MEDIUM_RISK_ATTACHMENTS: Comma-separated list of file extensions that should be
## flagged as ⚠️ in the exported Markdown. Defaults to: xml, json, csv, xlsx, xls, tsv, ods
# JIRA_MEDIUM_RISK_ATTACHMENTS="xml, json, csv, xlsx, xls, tsv, ods"

## Credentials, tokens, API keys, and passwords are always redacted from exported Markdown.
## PII redaction (emails, card numbers) is on by default. Set to false to disable.
JIRA_REDACT_PII=true

## Fetch each subtask and child work item (for Epics) recursively (default: false)
JIRA_FETCH_SUBTASKS_RECURSIVELY=false
